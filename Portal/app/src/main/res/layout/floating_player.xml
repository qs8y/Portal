<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000">
    <androidx.media3.ui.PlayerView android:id="@+id/fpv" android:layout_width="match_parent"
        android:layout_height="match_parent" app:resize_mode="fit" app:use_controller="false"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:orientation="horizontal">
        <TextView android:id="@+id/fPlay" style="@style/FloatBtn" android:text="&#9199;"/>
        <TextView android:id="@+id/fExpand" style="@style/FloatBtn" android:text="&#10530;"/>
        <TextView android:id="@+id/fClose" style="@style/FloatBtn" android:text="&#10005;"/>
    </LinearLayout>
    <TextView android:id="@+id/fResize" android:layout_width="36dp" android:layout_height="36dp"
        android:layout_gravity="bottom|end" android:gravity="center" android:text="&#9698;"
        android:textColor="#FFFFFF" android:textSize="20sp" android:background="#55000000"/>
</FrameLayout>
