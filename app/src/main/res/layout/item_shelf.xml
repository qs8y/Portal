<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="180dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp"
    android:clickable="true" android:focusable="true" app:cardCornerRadius="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/shThumb" android:layout_width="match_parent" android:layout_height="100dp"
            android:scaleType="centerCrop" android:background="?attr/colorSurfaceVariant"
            android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/shTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="2" android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceTitleSmall"/>
            <TextView android:id="@+id/shSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
