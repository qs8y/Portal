<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="?attr/colorSurface">

    <FrameLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <LinearLayout android:id="@+id/errorPanel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?attr/colorSurface" android:gravity="center" android:orientation="vertical"
        android:padding="32dp" android:visibility="gone" android:clickable="true">
        <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceBodyLarge"/>
        <Button android:id="@+id/errRetry" style="@style/Widget.Material3.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Retry"/>
        <Button android:id="@+id/errOpen" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Open in browser"/>
    </LinearLayout>

    <ScrollView android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?attr/colorSurface" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="110dp" android:paddingBottom="120dp">
            <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Welcome to Portal"
                android:textColor="?attr/colorOnSurface" android:textAppearance="?attr/textAppearanceHeadlineMedium"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center"
                android:text="Add the websites you like to watch from. Nothing is added for you, so this app only shows what you choose."
                android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="?attr/textAppearanceBodyMedium"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:hint="Website address">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/wUrl"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textUri" android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:hint="Name (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/wName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Button android:id="@+id/wAdd" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Add website"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center"
                android:text="You can add, edit or remove websites anytime in More \u2192 Settings \u2192 Websites."
                android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="?attr/textAppearanceBodySmall"/>
        </LinearLayout>
    </ScrollView>

    <FrameLayout android:id="@+id/topWrap" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="top"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/topPill"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/portalBarColor" app:cardCornerRadius="?attr/portalBarRadius" app:cardElevation="?attr/portalBarElevation"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingStart="6dp" android:paddingEnd="6dp">
                    <LinearLayout android:id="@+id/siteRow" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true" android:focusable="true"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:padding="10dp" android:src="@drawable/ic_globe"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:importantForAccessibility="no"/>
                        <TextView android:id="@+id/pageTitle" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:ellipsize="end" android:maxLines="1" android:text="Portal"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceTitleSmall"/>
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:padding="11dp" android:src="@drawable/ic_swap"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:importantForAccessibility="no"/>
                    </LinearLayout>
                    <ImageButton android:id="@+id/btnRefresh" android:layout_width="44dp"
                        android:layout_height="44dp" android:padding="11dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Refresh" android:scaleType="fitCenter"
                        android:src="@drawable/ic_refresh" app:tint="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:max="100"
                    android:visibility="invisible" app:trackThickness="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <FrameLayout android:id="@+id/bottomWrap" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="6dp" android:paddingBottom="10dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/bottomBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/portalBarColor" app:cardCornerRadius="?attr/portalBarRadius" app:cardElevation="?attr/portalBarElevation"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="8dp" android:paddingEnd="8dp">
                <ImageButton android:id="@+id/btnBack" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1" android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" android:scaleType="fitCenter"
                    android:src="@drawable/ic_back" app:tint="?attr/colorOnSecondaryContainer"/>
                <ImageButton android:id="@+id/btnHome" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1" android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home" android:scaleType="fitCenter"
                    android:src="@drawable/ic_home" app:tint="?attr/colorOnSecondaryContainer"/>
                <ImageButton android:id="@+id/btnDl" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1" android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Download video" android:scaleType="fitCenter"
                    android:src="@drawable/ic_download" app:tint="?attr/colorOnSecondaryContainer"/>
                <ImageButton android:id="@+id/btnDownloads" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1" android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Downloads" android:scaleType="fitCenter"
                    android:src="@drawable/ic_list" app:tint="?attr/colorOnSecondaryContainer"/>
                <ImageButton android:id="@+id/btnMore" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1" android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More" android:scaleType="fitCenter"
                    android:src="@drawable/ic_apps" app:tint="?attr/colorOnSecondaryContainer"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <com.portal.app.TouchFrame android:id="@+id/fullscreen" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone" android:background="#000"/>
    <LinearLayout android:id="@+id/tools" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="16dp" android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/toolPip" style="@style/ToolPill" android:text="Mini player"
            android:drawableStart="@drawable/ic_pip"/>
        <TextView android:id="@+id/toolFloat" style="@style/ToolPill" android:text="Float"
            android:drawableStart="@drawable/ic_layers"/>
        <TextView android:id="@+id/toolPlayer" style="@style/ToolPill" android:text="App player"
            android:drawableStart="@drawable/ic_play"/>
        <TextView android:id="@+id/toolSave" style="@style/ToolPill" android:text="Save state"
            android:drawableStart="@drawable/ic_bookmark"/>
        <TextView android:id="@+id/toolRot" style="@style/ToolPill" android:text="Rotation"
            android:drawableStart="@drawable/ic_rotate"/>
    </LinearLayout>
    <TextView android:id="@+id/gestureHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="48dp"
        android:background="@drawable/bg_pip_round" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="#FFFFFF"
        android:textAppearance="?attr/textAppearanceLabelLarge" android:visibility="gone"/>
    <LinearLayout android:id="@+id/lockCover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="?attr/colorSurface" android:clickable="true" android:focusable="true"
        android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_lock"
            app:tint="?attr/colorPrimary" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Locked" android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"/>
        <Button android:id="@+id/btnUnlock" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Unlock"/>
    </LinearLayout>
</FrameLayout>
