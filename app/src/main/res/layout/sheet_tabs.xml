<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="8dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="8dp" android:paddingBottom="8dp" android:text="Tabs"
            android:textColor="?attr/colorOnSurface" android:textAppearance="?attr/textAppearanceHeadlineSmall"/>
        <LinearLayout android:id="@+id/tabList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
        <Button android:id="@+id/btnNewTab" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="New tab"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
